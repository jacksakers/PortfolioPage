rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Poster/gallery images: public read, authenticated write limited to images under 10MB.
    match /items/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Site-level images (profile photo, hero background): same public read / auth write rules.
    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
