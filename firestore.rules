rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public portfolio content: readable by anyone, writable only by the signed-in owner.
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /sections/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /items/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
